# Local development only. In Azure these come from Key Vault references.
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1
MCP_DATABRICKS_URL=https://mcp-databricks.<env>.azurecontainerapps.io/mcp
MCP_MYSQL_URL=https://mcp-mysql.<env>.azurecontainerapps.io/mcp
MCP_SNOWFLAKE_URL=https://mcp-snowflake.<env>.azurecontainerapps.io/mcp
MCP_API_KEY=<from Key Vault: mcp-api-key>
SPEECH_REGION=eastus
SPEECH_KEY=<from Key Vault: speech-key>
ALLOWED_ORIGINS=http://localhost:8000
